Story.lastPage = {
	style = "faded",
	text = [[I have searched fifty years of the same evening.

She is not in the woods. She is in the house, in the parts of it I never locked.

Whoever holds the key after me: keep the doors.

The house was never as shut as I wanted it to be.]],
}

